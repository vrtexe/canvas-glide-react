{
  "name": "@canvas-glide/react",
  "version": "1.0.1",
  "description": "React components and hook for canvas-glide: pan, zoom and pinch-to-zoom for images on a canvas, an img or a scrolled view, with mouse, touch, pen and wheel input.",
  "keywords": [
    "react",
    "react-component",
    "pan-zoom",
    "panzoom",
    "pinch-zoom",
    "pinch-to-zoom",
    "zoom",
    "pan",
    "image-viewer",
    "image-zoom",
    "canvas",
    "gestures",
    "touch",
    "typescript"
  ],
  "license": "MIT",
  "homepage": "https://vrtexe.github.io/canvas-glide-react-demo/",
  "bugs": {
    "url": "https://github.com/vrtexe/canvas-glide-react/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vrtexe/canvas-glide-react.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:dev": "tsc -b && vite build --watch",
    "lint": "oxlint",
    "test": "vitest run",
    "preview": "vite preview"
  },
  "dependencies": {
    "canvas-glide": "^1.0.1"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "main": "./dist/canvas-glide.js",
  "types": "./dist/canvas-glide.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/canvas-glide.d.ts",
      "default": "./dist/canvas-glide.js"
    }
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "jsdom": "^31.0.1",
    "localforage": "^1.10.0",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^5.1.0"
  }
}
